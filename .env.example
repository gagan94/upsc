# Copy to .env and fill in. Never commit real values.

# --- API (apps/api) ---
# API: Postgres connection string (secret).
DATABASE_URL=
# API: port the HTTP server listens on (not secret).
PORT=4000
# API: allowed CORS origin, the web app URL (not secret).
WEB_ORIGIN=http://localhost:3000
# API: Supabase project URL used to verify JWTs (not secret).
SUPABASE_URL=
# API: JWT secret, only for HS256 Supabase projects, optional (secret).
SUPABASE_JWT_SECRET=
# API: runtime mode, development or production (not secret).
NODE_ENV=development

# --- Web (apps/web) ---
# Web: Supabase project URL, exposed to the browser (not secret).
NEXT_PUBLIC_SUPABASE_URL=
# Web: Supabase anon key, exposed to the browser (public by design, not secret).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web: set to true to show Google sign-in, exposed to the browser (not secret).
NEXT_PUBLIC_GOOGLE_ENABLED=false
# Web: server-side base URL of the API (not secret).
API_ORIGIN=http://localhost:4000

# --- Seed / deploy only ---
# Seed script: Supabase service role key, full access (secret).
SUPABASE_SERVICE_ROLE_KEY=
# Seed script: password assigned to demo users (secret).
DEMO_PASSWORD=
# Deploy: Render deploy hook URL, triggers a deploy (secret).
RENDER_DEPLOY_HOOK_URL=
