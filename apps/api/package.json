{
  "name": "@upsc/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "dotenv -e ../../.env -- ts-node src/main.ts",
    "dev": "dotenv -e ../../.env -- ts-node-dev --respawn src/main.ts",
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- ts-node src/db/migrate.ts",
    "seed": "dotenv -e ../../.env -- ts-node src/seed/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "10",
    "@nestjs/core": "10",
    "@nestjs/platform-express": "10",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^9",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@nestjs/testing": "10",
    "@types/express": "4",
    "@types/jest": "29",
    "@types/node": "20",
    "@types/pg": "^8.23.1",
    "@types/supertest": "6",
    "@types/uuid": "^9",
    "dotenv-cli": "7",
    "drizzle-kit": "^0.31.11",
    "jest": "29",
    "supertest": "7",
    "ts-jest": "29",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5"
  }
}
