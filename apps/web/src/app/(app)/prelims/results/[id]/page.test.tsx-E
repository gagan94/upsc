import { render, screen } from "@testing-library/react";
import { beforeEach, describe, expect, it, vi } from "vitest";
import { ApiError } from "@/lib/api";
import { RESULTS_SESSION_ID, results } from "@/components/practice/review-fixtures";

const serverApi = vi.fn();
vi.mock("@/lib/server-api", () => ({ serverApi: (...a: unknown[]) => serverApi(...a) }));
const redirect = vi.fn((url: string) => {
  throw new Error(`NEXT_REDIRECT:${url}`);
});
vi.mock("next/navigation", () => ({ redirect: (u: string) => redirect(u), useRouter: () => ({ push: vi.fn(), refresh: vi.fn() }) }));

import ResultsPage from "./page";

const call = () => ResultsPage({ params: Promise.resolve({ id: RESULTS_SESSION_ID }) });
beforeEach(() => serverApi.mockReset());

describe("ResultsPage", () => {
  it("loads and renders results", async () => {
    serverApi.mockResolvedValue(results());
    render(await call());
    expect(serverApi).toHaveBeenCalledWith(`/practice/sessions/${RESULTS_SESSION_ID}/results`);
    expect(screen.getByRole("heading", { name: "Results" })).toBeInTheDocument();
  });
  it("redirects to /login on 401", async () => {
    serverApi.mockRejectedValue(new ApiError(401, "unauthenticated", "no"));
    await expect(call()).rejects.toThrow("NEXT_REDIRECT:/login");
  });
  it("sends an in-progress session back to the workspace", async () => {
    serverApi.mockRejectedValue(new ApiError(409, "not_submitted", "not yet"));
    await expect(call()).rejects.toThrow(`NEXT_REDIRECT:/prelims/session/${RESULTS_SESSION_ID}`);
  });
  it("shows an embedded error with a retry on failure", async () => {
    serverApi.mockRejectedValue(new ApiError(500, "internal", "boom"));
    render(await call());
    expect(screen.getByRole("button", { name: "Try again" })).toBeInTheDocument();
    expect(document.querySelector("main")).toBeNull();
  });
  it("says so for an unknown set", async () => {
    serverApi.mockRejectedValue(new ApiError(404, "not_found", "x"));
    render(await call());
    expect(screen.getByRole("heading", { name: /couldn't find/ })).toBeInTheDocument();
  });
});
